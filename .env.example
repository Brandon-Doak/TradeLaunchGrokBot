# Copy to .env and fill in to use the real Grok (xAI) API.
# When GROK_API_KEY is empty, the bot runs with a deterministic offline
# mock model so it works end-to-end without any credentials or network.

# xAI API key (https://console.x.ai). Leave empty to use the offline mock model.
GROK_API_KEY=

# xAI OpenAI-compatible endpoint and model.
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# Comma-separated tickers to trade.
TRADELAUNCH_TICKERS=BTC-USD,ETH-USD,SOL-USD

# Starting paper-trading cash in USD.
TRADELAUNCH_STARTING_CASH=10000
